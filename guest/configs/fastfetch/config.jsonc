// fastfetch banner for the agent VM. Shown once per login shell (see
// configs/zsh/zshrc, which cats word.txt — the KATASTROPHE wordmark — just
// above this). The logo is hand-authored ANSI cat art (logo.ans) printed via
// logo.type=file-raw, so the VM needs no runtime image protocol — works over
// ssh and the serial console. Edit logo.ans / word.txt to change the banner.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/agent/.config/fastfetch/logo.ans",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;217;119;87" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",
    { "type": "os", "key": "os    " },
    { "type": "host", "key": "host  " },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    "break",
    { "type": "cpu", "key": "cpu   " },
    { "type": "gpu", "key": "gpu   " },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk  ", "folders": "/" },
    "break",
    { "type": "localip", "key": "ip    ", "compact": true }
  ]
}
